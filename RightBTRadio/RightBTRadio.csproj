<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RightBTRadio</AssemblyName>
    <RootNamespace>RightBTRadio</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Mantiene habilitado solo el radio Bluetooth de mayor prioridad.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RightBTRadio.Tests" />
  </ItemGroup>
</Project>
