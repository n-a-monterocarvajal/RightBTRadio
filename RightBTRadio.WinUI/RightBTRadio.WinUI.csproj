<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RightBTRadio.WinUI</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\RightBTRadio.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RightBTRadio.Core\RightBTRadio.Core.csproj" />
  </ItemGroup>

  <!--
    Tomado de RightKeyboard.WinUI. `dotnet publish` no conserva estos recursos generados
    para una aplicación WinUI no empaquetada. Sin ellos XamlControlsResources no resuelve
    el tema y la ventana publicada se cierra con 0xC000027B, aunque la carpeta de
    compilación sí funcione. Reproducido en este repositorio antes de agregar el destino.
  -->
  <Target Name="CopyWinUiGeneratedResourcesToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <WinUiAppXbf>$(TargetDir)App.xbf</WinUiAppXbf>
      <WinUiAppPri>$(TargetDir)$(AssemblyName).pri</WinUiAppPri>
    </PropertyGroup>

    <Error Condition="!Exists('$(WinUiAppXbf)')"
           Text="No se encontró el recurso WinUI generado: $(WinUiAppXbf)" />
    <Error Condition="!Exists('$(WinUiAppPri)')"
           Text="No se encontró el índice de recursos WinUI generado: $(WinUiAppPri)" />
    <Copy SourceFiles="$(WinUiAppXbf);$(WinUiAppPri)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
