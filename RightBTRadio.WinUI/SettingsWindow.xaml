<Window
    x:Class="RightBTRadio.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RightBTRadio.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <Style x:Key="PanelCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <!--  Barra inferior de cada panel, separada de la lista por una línea.  -->
            <Style x:Key="PanelBarStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarArea"
            Height="40"
            Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Image
                    Width="16"
                    Height="16"
                    Source="ms-appx:///Assets/RightBTRadio.png" />
                <TextBlock
                    x:Name="TitleBarText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!--
                Botonera de la barra de título. El margen derecho y las zonas clicables los
                calcula TitleBarInteraction. Orden: Ajustes, Acerca de, Ayuda. Lo único fijado
                por la barra de menús clásica es que Ayuda va última.
            -->
            <StackPanel
                x:Name="TitleBarCluster"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <StackPanel.Resources>
                    <!--
                        SubtleButtonStyle: sin relleno en reposo y con un hover que sí se
                        percibe sobre Mica, a diferencia del Button por defecto. Padding 0 no es
                        cosmético: con el borde de 1 del estilo, un relleno de 8 deja 14 px para
                        un glifo de 16 y le corta la fila superior.
                    -->
                    <Style
                        x:Key="TitleBarIconButtonStyle"
                        BasedOn="{StaticResource SubtleButtonStyle}"
                        TargetType="Button">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinWidth" Value="32" />
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                    </Style>
                </StackPanel.Resources>

                <Button
                    x:Name="SettingsButton"
                    AutomationProperties.Name="Ajustes"
                    Style="{StaticResource TitleBarIconButtonStyle}"
                    ToolTipService.ToolTip="Ajustes">
                    <FontIcon
                        Width="16"
                        Height="16"
                        FontSize="16"
                        Glyph="&#xE713;" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="Padding" Value="20" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <!--  Ancho fijo: un Flyout mide con ancho infinito y el texto no envolvería.  -->
                            <StackPanel Width="300" Spacing="16">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Ajustes" />
                                <ToggleSwitch
                                    x:Name="StartWithWindowsToggle"
                                    Header="Iniciar con Windows"
                                    OffContent="No"
                                    OnContent="Sí"
                                    Toggled="OnStartWithWindowsToggled" />
                                <ToggleSwitch
                                    x:Name="StartMinimizedToggle"
                                    OffContent="No"
                                    OnContent="Sí"
                                    Toggled="OnStartMinimizedToggled">
                                    <ToggleSwitch.Header>
                                        <TextBlock Text="Iniciar solo en el área de notificación, sin abrir esta ventana" TextWrapping="Wrap" />
                                    </ToggleSwitch.Header>
                                </ToggleSwitch>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <RadioButtons
                                    x:Name="ThemeRadioButtons"
                                    Header="Tema"
                                    SelectionChanged="OnThemeSelectionChanged">
                                    <RadioButton Content="Sistema" Tag="System" />
                                    <RadioButton Content="Claro" Tag="Light" />
                                    <RadioButton Content="Oscuro" Tag="Dark" />
                                </RadioButtons>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    x:Name="AboutButton"
                    AutomationProperties.Name="Acerca de RightBTRadio"
                    Style="{StaticResource TitleBarIconButtonStyle}"
                    ToolTipService.ToolTip="Acerca de">
                    <FontIcon
                        Width="16"
                        Height="16"
                        FontSize="16"
                        Glyph="&#xE946;" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="Padding" Value="20" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Width="320" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Source="ms-appx:///Assets/RightBTRadio.png" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="RightBTRadio" />
                                        <TextBlock
                                            x:Name="AboutVersionText"
                                            Opacity="0.65"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <!--  La identidad va fuera de la tarjeta; lo que se cuenta de la aplicación, dentro.  -->
                                <Border
                                    Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <StackPanel Spacing="12">
                                        <TextBlock
                                            x:Name="AboutDescriptionText"
                                            Opacity="0.85"
                                            TextWrapping="Wrap" />
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <TextBlock
                                            Opacity="0.8"
                                            Text="Licencia MIT. © 2026 n-a-monterocarvajal."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    x:Name="HelpButton"
                    AutomationProperties.Name="Ayuda y preguntas frecuentes"
                    Style="{StaticResource TitleBarIconButtonStyle}"
                    ToolTipService.ToolTip="Ayuda">
                    <FontIcon
                        Width="16"
                        Height="16"
                        FontSize="16"
                        Glyph="&#xE897;" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <ScrollViewer
                                Width="440"
                                MaxHeight="560"
                                Padding="20"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Width="400" Spacing="14">
                                    <StackPanel.Resources>
                                        <Style TargetType="Expander">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </StackPanel.Resources>

                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Ayuda y preguntas frecuentes" />

                                    <Expander Header="¿Por qué deshabilitar un radio?">
                                        <TextBlock Padding="0,12,0,4" Text="Windows no puede usar dos radios Bluetooth a la vez. Si conecta un adaptador USB a un equipo que ya tiene Bluetooth integrado, uno de los dos deja de funcionar y el Administrador de dispositivos muestra el código 31. RightBTRadio deja habilitado un solo radio y deshabilita los demás." />
                                    </Expander>

                                    <Expander Header="¿Qué radio queda habilitado?">
                                        <TextBlock Padding="0,12,0,4" Text="El primer radio conectado del grupo de prioridad. Si lo desconecta, se habilita el siguiente de la lista. Cuando lo vuelve a conectar, recupera su lugar. RightBTRadio no modifica los radios que no están en el grupo." />
                                    </Expander>

                                    <Expander Header="¿Qué pasa con los dispositivos emparejados?">
                                        <StackPanel Padding="0,12,0,4" Spacing="8">
                                            <TextBlock Text="Al deshabilitar un radio se desconecta todo lo que está emparejado con él. Si su teclado o su mouse usan ese radio, dejarán de responder hasta que los conecte por cable." />
                                            <TextBlock Opacity="0.78" Text="Para recuperarlos, haga clic con el botón derecho en el icono de RightBTRadio, en el área de notificación, y elija «Habilitar todos los radios». Desinstalar la aplicación también los habilita." />
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="¿Qué significan «Interno» y «Externo»?">
                                        <TextBlock Padding="0,12,0,4" Text="Indican si Windows considera que el radio se puede quitar del equipo, como un adaptador USB, o si viene integrado. Es solo informativo: la prioridad depende únicamente del orden del grupo." />
                                    </Expander>

                                    <Expander Header="¿Por qué se pidió permiso de administrador?">
                                        <TextBlock Padding="0,12,0,4" Text="Windows lo exige para habilitar y deshabilitar dispositivos. RightBTRadio registra una sola vez dos tareas programadas que hacen ese trabajo. Después no vuelve a pedir permiso." />
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--
            Sin desplazamiento de página: como en RightKeyboard, los dos paneles ocupan el
            alto disponible y son sus listas las que se desplazan.
        -->
        <Grid
            Grid.Row="1"
            Padding="24,4,24,24"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="RightBTRadio" />
                <TextBlock
                    x:Name="Subtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Radios Bluetooth  -->
                <Border Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Padding="16,14,16,8" Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Radios" />
                            <TextBlock
                                x:Name="DevicesDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ListView
                            x:Name="DevicesList"
                            Grid.Row="1"
                            Padding="4,0,4,8"
                            AutomationProperties.Name="Radios"
                            SelectionChanged="OnDeviceSelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RadioRow">
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Margin="0,7,0,0"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="{x:Bind ConnectionText}"
                                            Fill="{x:Bind ConnectionBrush}"
                                            ToolTipService.ToolTip="{x:Bind ConnectionText}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind Primary}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Primary}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Secondary}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTipService.ToolTip="{x:Bind Secondary}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Description}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTipService.ToolTip="{x:Bind Description}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            Spacing="2">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind State}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Kind}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Grid.Row="2" Style="{StaticResource PanelBarStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="AliasTextBox"
                                    AutomationProperties.Name="Nombre del radio"
                                    PlaceholderText="Nombre (opcional)" />
                                <Button
                                    x:Name="AddButton"
                                    Grid.Column="1"
                                    Click="OnAddClick"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                                        <TextBlock x:Name="AddButtonText" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="RemoveButton"
                                    Grid.Column="2"
                                    AutomationProperties.Name="Quitar del grupo"
                                    Click="OnRemoveClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE738;" />
                                        <TextBlock Text="Quitar" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!--  Grupo de prioridad  -->
                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Padding="16,14,16,8" Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Grupo de prioridad" />
                            <TextBlock
                                x:Name="PriorityDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ListView
                            x:Name="PriorityList"
                            Grid.Row="1"
                            Padding="4,0,4,8"
                            AutomationProperties.Name="Grupo de prioridad"
                            SelectionChanged="OnPrioritySelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RadioRow">
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            MinWidth="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Position}" />
                                        <Ellipse
                                            Grid.Column="1"
                                            Width="6"
                                            Height="6"
                                            Margin="0,7,0,0"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="{x:Bind ConnectionText}"
                                            Fill="{x:Bind ConnectionBrush}"
                                            ToolTipService.ToolTip="{x:Bind ConnectionText}" />
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind Primary}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Primary}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Secondary}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTipService.ToolTip="{x:Bind Secondary}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Description}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTipService.ToolTip="{x:Bind Description}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind State}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Grid.Row="2" Style="{StaticResource PanelBarStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="MoveUpButton"
                                    AutomationProperties.Name="Subir"
                                    Click="OnMoveUpClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE70E;" />
                                        <TextBlock Text="Subir" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="MoveDownButton"
                                    AutomationProperties.Name="Bajar"
                                    Click="OnMoveDownClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE70D;" />
                                        <TextBlock Text="Bajar" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
