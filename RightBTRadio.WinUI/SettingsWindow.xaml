<Window
    x:Class="RightBTRadio.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RightBTRadio.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <Style x:Key="PanelCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <!--  Barra inferior de cada panel, separada de la lista por una línea.  -->
            <Style x:Key="PanelBarStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Height="40" Padding="16,0,0,0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Image
                    Width="16"
                    Height="16"
                    Source="ms-appx:///Assets/RightBTRadio.png" />
                <TextBlock
                    x:Name="TitleBarText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!--
            Sin desplazamiento de página: como en RightKeyboard, los dos paneles ocupan el
            alto disponible y son sus listas las que se desplazan.
        -->
        <Grid
            Grid.Row="1"
            Padding="24,4,24,24"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="RightBTRadio" />
                <TextBlock
                    x:Name="Subtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Radios Bluetooth  -->
                <Border Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Padding="16,14,16,8" Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Radios" />
                            <TextBlock
                                x:Name="DevicesDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ListView
                            x:Name="DevicesList"
                            Grid.Row="1"
                            Padding="4,0,4,8"
                            AutomationProperties.Name="Radios"
                            SelectionChanged="OnDeviceSelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RadioRow">
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Margin="0,7,0,0"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="{x:Bind ConnectionText}"
                                            Fill="{x:Bind ConnectionBrush}"
                                            ToolTipService.ToolTip="{x:Bind ConnectionText}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind Primary}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Primary}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Secondary}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTipService.ToolTip="{x:Bind Secondary}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Description}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTipService.ToolTip="{x:Bind Description}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            Spacing="2">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind State}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Kind}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Grid.Row="2" Style="{StaticResource PanelBarStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="AliasTextBox"
                                    AutomationProperties.Name="Alias"
                                    PlaceholderText="Alias, por ejemplo Toocki" />
                                <Button
                                    x:Name="AddButton"
                                    Grid.Column="1"
                                    Click="OnAddClick"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                                        <TextBlock x:Name="AddButtonText" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="RemoveButton"
                                    Grid.Column="2"
                                    AutomationProperties.Name="Quitar del grupo"
                                    Click="OnRemoveClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE738;" />
                                        <TextBlock Text="Quitar" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!--  Grupo de prioridad  -->
                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Padding="16,14,16,8" Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Grupo de prioridad" />
                            <TextBlock
                                x:Name="PriorityDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ListView
                            x:Name="PriorityList"
                            Grid.Row="1"
                            Padding="4,0,4,8"
                            AutomationProperties.Name="Grupo de prioridad"
                            SelectionChanged="OnPrioritySelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RadioRow">
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            MinWidth="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Position}" />
                                        <Ellipse
                                            Grid.Column="1"
                                            Width="6"
                                            Height="6"
                                            Margin="0,7,0,0"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="{x:Bind ConnectionText}"
                                            Fill="{x:Bind ConnectionBrush}"
                                            ToolTipService.ToolTip="{x:Bind ConnectionText}" />
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind Primary}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Primary}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Secondary}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTipService.ToolTip="{x:Bind Secondary}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Description}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTipService.ToolTip="{x:Bind Description}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind State}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Grid.Row="2" Style="{StaticResource PanelBarStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="MoveUpButton"
                                    AutomationProperties.Name="Subir"
                                    Click="OnMoveUpClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE70E;" />
                                        <TextBlock Text="Subir" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="MoveDownButton"
                                    AutomationProperties.Name="Bajar"
                                    Click="OnMoveDownClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE70D;" />
                                        <TextBlock Text="Bajar" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!--  Ajustes generales  -->
            <Border
                Grid.Row="2"
                Padding="16,8"
                Style="{StaticResource PanelCardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="48">
                    <ToggleSwitch
                        x:Name="StartWithWindowsToggle"
                        Header="Iniciar con Windows"
                        OffContent="No"
                        OnContent="Sí"
                        Toggled="OnStartWithWindowsToggled" />
                    <ToggleSwitch
                        x:Name="StartMinimizedToggle"
                        Header="Iniciar minimizado en el área de notificación"
                        OffContent="No"
                        OnContent="Sí"
                        Toggled="OnStartMinimizedToggled" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
